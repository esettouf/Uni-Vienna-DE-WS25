{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BidCancelResponse",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "messageType": {
          "type": "string",
          "const": "BID_CANCEL_RESPONSE"
        },
        "version": { "type": "string" },
        "messageId": { "type": "string" },
        "correlationId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "targetSystem": { "type": "string" }
      },
      "required": [
        "messageType",
        "version",
        "messageId",
        "correlationId",
        "timestamp"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "bidId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["CANCELLED", "REJECTED"]
        },
        "reason": { "type": "string" }
      },
      "required": ["bidId", "status"]
    }
  },
  "required": ["meta", "data"]
}
