{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KybDecisionEvent",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageType": { "type": "string", "const": "KYB_DECISION_EVENT" },
        "version": { "type": "string", "const": "1.0" },
        "messageId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "targetSystem": { "type": "string" }
      },
      "required": ["messageType", "version", "messageId", "timestamp", "sourceSystem", "targetSystem"]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onboardingId": { "type": "string" },
        "companyId": { "type": "string" },
        "result": { "type": "string", "enum": ["VERIFIED", "REJECTED", "MANUAL_REVIEW_REQUIRED"] },
        "checkedAt": { "type": "string", "format": "date-time" },
        "reasonCode": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["onboardingId", "companyId", "result", "checkedAt"],
      "allOf": [
        {
          "if": { "properties": { "result": { "enum": ["REJECTED", "MANUAL_REVIEW_REQUIRED"] } } },
          "then": { "required": ["reasonCode", "reason"] }
        }
      ]
    }
  },
  "required": ["meta", "data"]
}
