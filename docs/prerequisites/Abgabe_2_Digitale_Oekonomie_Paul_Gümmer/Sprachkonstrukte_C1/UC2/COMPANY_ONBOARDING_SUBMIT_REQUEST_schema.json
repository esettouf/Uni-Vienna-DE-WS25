{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanyOnboardingSubmitRequest",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageType": { "type": "string", "const": "COMPANY_ONBOARDING_SUBMIT_REQUEST" },
        "version": { "type": "string", "const": "1.0" },
        "messageId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "targetSystem": { "type": "string" }
      },
      "required": ["messageType", "version", "messageId", "timestamp", "sourceSystem", "targetSystem"]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onboardingId": { "type": "string" },
        "company": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "companyId": { "type": "string" },
            "name": { "type": "string" },
            "vatNumber": { "type": "string" },
            "address": { "type": "string" },
            "contactEmail": { "type": "string", "format": "email" }
          },
          "required": ["companyId", "name", "vatNumber", "address", "contactEmail"]
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Document" }
        }
      },
      "required": ["onboardingId", "company", "documents"]
    }
  },
  "required": ["meta", "data"],
  "$defs": {
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentType": {
          "type": "string",
          "enum": ["REGISTER_EXTRACT", "VAT_PROOF", "OTHER"]
        },
        "fileName": { "type": "string" },
        "contentType": { "type": "string" },
        "contentBase64": { "type": "string" }
      },
      "required": ["documentType", "fileName", "contentType", "contentBase64"]
    }
  }
}
