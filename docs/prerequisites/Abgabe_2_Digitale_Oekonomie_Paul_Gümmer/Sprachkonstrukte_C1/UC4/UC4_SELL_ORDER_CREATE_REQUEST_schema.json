{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SellOrderCreateRequest",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "messageType": { "type": "string", "const": "SELL_ORDER_CREATE_REQUEST" },
        "version": { "type": "string" },
        "messageId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "targetSystem": { "type": "string" }
      },
      "required": ["messageType", "version", "messageId", "timestamp"]
    },
    "data": {
      "type": "object",
      "properties": {
        "sellOrderId": { "type": "string" },
        "sellerType": { "type": "string", "enum": ["USER", "COMPANY_PROVIDER"] },
        "sellerId": { "type": "string" },
        "certificateIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "minPricePerUnitEur": { "type": "number", "exclusiveMinimum": 0 },
        "validUntil": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "required": [
        "sellOrderId",
        "sellerType",
        "sellerId",
        "certificateIds",
        "minPricePerUnitEur",
        "currency"
      ]
    }
  },
  "required": ["meta", "data"]
}
