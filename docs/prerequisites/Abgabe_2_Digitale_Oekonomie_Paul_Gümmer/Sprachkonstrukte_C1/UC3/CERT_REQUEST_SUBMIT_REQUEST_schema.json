{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertRequestSubmitRequest",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageType": { "type": "string", "const": "CERT_REQUEST_SUBMIT_REQUEST" },
        "version": { "type": "string", "const": "1.0" },
        "messageId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "targetSystem": { "type": "string" }
      },
      "required": ["messageType", "version", "messageId", "timestamp", "sourceSystem", "targetSystem"]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batchId": { "type": "string" },
        "userId": { "type": "string" },
        "requestYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "vehicles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/VehicleWithEvidence" }
        }
      },
      "required": ["batchId", "userId", "requestYear", "vehicles"]
    }
  },
  "required": ["meta", "data"],
  "$defs": {
    "EvidenceDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentType": { "type": "string", "enum": ["REGISTRATION_CERT", "OTHER"] },
        "fileName": { "type": "string" },
        "contentType": { "type": "string" },
        "contentBase64": { "type": "string" }
      },
      "required": ["documentType", "fileName", "contentType", "contentBase64"]
    },
    "VehicleWithEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vehicleId": { "type": "string" },
        "licensePlate": { "type": "string" },
        "isElectric": { "type": "boolean" },
        "vehicleType": { "type": "string" },
        "registrationYear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "vin": { "type": "string" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/EvidenceDocument" }
        }
      },
      "required": ["vehicleId", "licensePlate", "isElectric", "vehicleType", "registrationYear", "vin", "evidence"]
    }
  }
}
