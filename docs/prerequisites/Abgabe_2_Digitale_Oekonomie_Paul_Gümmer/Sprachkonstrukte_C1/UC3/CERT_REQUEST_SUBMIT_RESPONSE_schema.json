{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertRequestSubmitResponse",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageType": { "type": "string", "const": "CERT_REQUEST_SUBMIT_RESPONSE" },
        "version": { "type": "string", "const": "1.0" },
        "messageId": { "type": "string" },
        "correlationId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "targetSystem": { "type": "string" }
      },
      "required": ["messageType", "version", "messageId", "correlationId", "timestamp", "sourceSystem", "targetSystem"]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batchId": { "type": "string" },
        "status": { "type": "string", "enum": ["ACCEPTED", "REJECTED"] },
        "acceptedRequests": {
          "type": "array",
          "items": { "$ref": "#/$defs/RequestKey" }
        },
        "rejectedRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "vehicleId": { "type": "string" },
              "requestYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
              "reasonCode": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["vehicleId", "requestYear", "reasonCode", "reason"]
          }
        }
      },
      "required": ["batchId", "status", "acceptedRequests", "rejectedRequests"]
    }
  },
  "required": ["meta", "data"],
  "$defs": {
    "RequestKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vehicleId": { "type": "string" },
        "requestYear": { "type": "integer", "minimum": 2000, "maximum": 2100 }
      },
      "required": ["vehicleId", "requestYear"]
    }
  }
}
