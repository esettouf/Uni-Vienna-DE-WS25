{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertDecisionEvent",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageType": { "type": "string", "const": "CERT_DECISION_EVENT" },
        "version": { "type": "string", "const": "1.0" },
        "messageId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "targetSystem": { "type": "string" }
      },
      "required": ["messageType", "version", "messageId", "timestamp", "sourceSystem", "targetSystem"]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batchId": { "type": "string" },
        "decision": { "type": "string", "enum": ["APPROVED", "PARTIAL_APPROVAL", "REJECTED"] },
        "issuedCertificates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "vehicleId": { "type": "string" },
              "requestYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
              "certificate": { "$ref": "#/$defs/Certificate" }
            },
            "required": ["vehicleId", "requestYear", "certificate"]
          }
        },
        "rejectedRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "vehicleId": { "type": "string" },
              "requestYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
              "reasonCode": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["vehicleId", "requestYear", "reasonCode", "reason"]
          }
        },
        "decidedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["batchId", "decision", "issuedCertificates", "rejectedRequests", "decidedAt"]
    }
  },
  "required": ["meta", "data"],
  "$defs": {
    "Certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "certificateId": { "type": "string" },
        "issueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "amountCO2": { "type": "number" },
        "blockchainHash": { "type": "string" }
      },
      "required": ["certificateId", "issueDate", "status", "amountCO2", "blockchainHash"]
    }
  }
}
